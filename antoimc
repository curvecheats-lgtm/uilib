-- Page/Tab Creation
function Library:Page(props)
    props = props or {}
    local name = props.Name or "Tab"
    
    local page = {}
    page.Name = name
    page.Elements = {}
    
    -- Tab Button
    local btn = Instance.new("TextButton")
    btn.Name = name
    btn.Size = UDim2.new(1, 0, 0, 28)
    btn.BackgroundColor3 = self.Theme.Background
    btn.BackgroundTransparency = 0.5
    btn.Text = name
    btn.TextColor3 = self.Theme.DarkText
    btn.TextSize = 12
    btn.Font = Enum.Font.Gotham
    btn.Parent = self.TabBar
    
    local btnCorner = Instance.new("UICorner", btn)
    btnCorner.CornerRadius = UDim.new(0, 4)
    
    -- Page Content
    local frame = Instance.new("ScrollingFrame")
    frame.Name = name .. "_Content"
    frame.Size = UDim2.new(1, 0, 1, 0)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.ScrollBarThickness = 2
    frame.ScrollBarImageColor3 = self.Theme.Accent
    frame.Visible = false
    frame.Parent = self.Content
    
    -- Auto-size canvas
    local function updateCanvas()
        local max = 0
        for _, child in ipairs(frame:GetChildren()) do
            if child:IsA("Frame") then
                max = math.max(max, child.Position.Y.Offset + child.Size.Y.Offset)
            end
        end
        frame.CanvasSize = UDim2.new(0, 0, 0, max + 10)
    end
    
    -- Tab Selection
    local function select()
        if self.CurrentTab == page then return end
        
        if self.CurrentTab then
            self.CurrentTab.Button.BackgroundColor3 = self.Theme.Background
            self.CurrentTab.Button.TextColor3 = self.Theme.DarkText
            self.CurrentTab.Frame.Visible = false
        end
        
        self.CurrentTab = page
        btn.BackgroundColor3 = self.Theme.Accent
        btn.TextColor3 = self.Theme.Background
        frame.Visible = true
    end
    
    btn.MouseButton1Click:Connect(select)
    
    page.Button = btn
    page.Frame = frame
    page.UpdateCanvas = updateCanvas
    
    -- Auto-select first tab
    if #self.Tabs == 0 then
        select()
    end
    
    table.insert(self.Tabs, page)
    
