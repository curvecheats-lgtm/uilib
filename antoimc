            dropdown.Size = UDim2.new(1, 0, 0, 0)
            dropdown.Position = UDim2.new(0, 0, 1, 2)
            dropdown.BackgroundColor3 = Library.Theme.Secondary
            dropdown.BorderSizePixel = 0
            dropdown.ClipsDescendants = true
            dropdown.Visible = false
            dropdown.ZIndex = 100
            dropdown.Parent = listBtn
            
            local dropCorner = Instance.new("UICorner", dropdown)
            dropCorner.CornerRadius = UDim.new(0, 4)
            
            local dropLayout = Instance.new("UIListLayout", dropdown)
            dropLayout.SortOrder = Enum.SortOrder.LayoutOrder
            
            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, 20)
                optBtn.BackgroundTransparency = 1
                optBtn.Text = opt
                optBtn.TextColor3 = Library.Theme.Text
                optBtn.TextSize = 11
                optBtn.Font = Enum.Font.Gotham
                optBtn.ZIndex = 101
                optBtn.Parent = dropdown
                
                optBtn.MouseButton1Click:Connect(function()
                    Library.Flags[flag] = opt
                    listBtn.Text = opt
                    dropdown.Visible = false
                    pcall(callback, opt)
                end)
            end
            
            dropdown.Size = UDim2.new(1, 0, 0, math.min(#options * 20, 100))
            
            listBtn.MouseButton1Click:Connect(function()
                dropdown.Visible = not dropdown.Visible
            end)
            
            return listBtn
        end
        
        -- Colorpicker
