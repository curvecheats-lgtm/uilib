-- Open/Close
function Library:SetOpen(state)
    self.Open = state
    if state then
        self.Holder.Visible = true
        self.Holder.Size = UDim2.new(0, 580, 0, 40)
        TweenService:Create(self.Holder, TweenInfo.new(0.2), {Size = UDim2.new(0, 580, 0, 400)}):Play()
    else
        TweenService:Create(self.Holder, TweenInfo.new(0.2), {Size = UDim2.new(0, 580, 0, 40)}):Play()
        task.delay(0.2, function()
            if not self.Open then
                self.Holder.Visible = false
            end
        end)
    end
end

