        end
        
        table.insert(section.Elements, section)
        return section
    end
    
    return page
end

-- Notification System
function Library:Notify(text, duration, type)
    duration = duration or 3
    type = type or "info"
    
    local colors = {
        info = Library.Theme.Accent,
        good = Library.Theme.Green,
        bad = Library.Theme.Red,
        warn = Color3.fromRGB(255, 200, 100)
    }
    
    local notif = Instance.new("Frame")
    notif.Size = UDim2.new(0, 200, 0, 40)
    notif.Position = UDim2.new(1, 220, 1, -50 - (#Library.Notifications * 45))
    notif.BackgroundColor3 = Library.Theme.Secondary
    notif.BorderSizePixel = 0
    notif.Parent = self.ScreenGui
    
    local corner = Instance.new("UICorner", notif)
    corner.CornerRadius = UDim.new(0, 6)
    
    local stroke = Instance.new("UIStroke", notif)
    stroke.Color = colors[type] or colors.info
    stroke.Thickness = 1
    
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 1, 0)
    lbl.Position = UDim2.new(0, 5, 0, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = text
    lbl.TextColor3 = Library.Theme.Text
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextWrapped = true
    lbl.Parent = notif
    
    table.insert(Library.Notifications, notif)
    
    TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, -210, 1, -50 - ((#Library.Notifications - 1) * 45))}):Play()
    
    task.delay(duration, function()
        TweenService:Create(notif, TweenInfo.new(0.3), {Position = UDim2.new(1, 220, notif.Position.Y.Scale, notif.Position.Y.Offset)}):Play()
        task.delay(0.3, function()
            notif:Destroy()
            for i, n in ipairs(Library.Notifications) do
                if n == notif then
                    table.remove(Library.Notifications, i)
                    break
                end
            end
            for i, n in ipairs(Library.Notifications) do
                TweenService:Create(n, TweenInfo.new(0.2), {Position = UDim2.new(1, -210, 1, -50 - ((i - 1) * 45))}):Play()
            end
        end)
    end)
end

-- Get flag value
function Library:GetFlag(flag)
    return Library.Flags[flag]
end

-- Set flag value
function Library:SetFlag(flag, value)
    Library.Flags[flag] = value
end

return Library
