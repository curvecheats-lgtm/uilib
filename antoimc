                TweenService:Create(box, TweenInfo.new(0.1), {BackgroundColor3 = state and Library.Theme.Accent or Library.Theme.Background}):Play()
                pcall(callback, state)
            end
            
            box.MouseButton1Click:Connect(function()
                set(not Library.Flags[flag])
            end)
            
            return {Set = set}
        end
        
        -- Slider
        function section:Slider(props)
            props = props or {}
            local side = props.Side == "Right" and rightCont or leftCont
            local flag = props.flag
            local min = props.min or 0
            local max = props.max or 100
            local default = props.default or min
            local decimals = props.decimals or 0
            local suffix = props.suffix or ""
            local callback = props.callback or function() end
            local name = props.Name or "Slider"
            
            Library.Flags[flag] = default
            
            local frame = Instance.new("Frame")
            frame.Size = UDim2.new(1, -4, 0, 36)
            frame.BackgroundTransparency = 1
            frame.Parent = side
            
            local label = Instance.new("TextLabel")
            label.Size = UDim2.new(1, 0, 0, 14)
            label.BackgroundTransparency = 1
            label.Text = name
            label.TextColor3 = Library.Theme.Text
            label.TextSize = 12
            label.Font = Enum.Font.Gotham
            label.TextXAlignment = Enum.TextXAlignment.Left
            label.Parent = frame
            
            local valueLabel = Instance.new("TextLabel")
            valueLabel.Size = UDim2.new(0, 40, 0, 14)
            valueLabel.Position = UDim2.new(1, -40, 0, 0)
            valueLabel.BackgroundTransparency = 1
            valueLabel.Text = formatNumber(default, decimals) .. suffix
            valueLabel.TextColor3 = Library.Theme.DarkText
            valueLabel.TextSize = 11
            valueLabel.Font = Enum.Font.Gotham
            valueLabel.TextXAlignment = Enum.TextXAlignment.Right
            valueLabel.Parent = frame
            
            local bar = Instance.new("Frame")
            bar.Size = UDim2.new(1, 0, 0, 6)
            bar.Position = UDim2.new(0, 0, 0, 22)
            bar.BackgroundColor3 = Library.Theme.Background
            bar.BorderSizePixel = 0
            bar.Parent = frame
            
            local barCorner = Instance.new("UICorner", bar)
            barCorner.CornerRadius = UDim.new(0, 3)
            
            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((default - min) / (max - min), 0, 1, 0)
            fill.BackgroundColor3 = Library.Theme.Accent
            fill.BorderSizePixel = 0
            fill.Parent = bar
            
            local fillCorner = Instance.new("UICorner", fill)
            fillCorner.CornerRadius = UDim.new(0, 3)
            
            local function set(val)
                val = math.clamp(val, min, max)
                Library.Flags[flag] = val
                fill.Size = UDim2.new((val - min) / (max - min), 0, 1, 0)
                valueLabel.Text = formatNumber(val, decimals) .. suffix
                pcall(callback, val)
            end
            
            local dragging = false
            bar.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = true
                end
            end)
            
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    dragging = false
                end
            end)
            
            UserInputService.InputChanged:Connect(function(input)
                if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
                    local pos = (input.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X
                    set(min + (max - min) * math.clamp(pos, 0, 1))
                end
            end)
            
            return {Set = set}
        end
        
